<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true">

    <!-- Top Bar Container -->
    <LinearLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnIncognitoBadge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_send"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Auto Claimer" />

        <!-- Address Bar Pill -->
        <LinearLayout
            android:id="@+id/addressBarPill"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_address_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/ivSecurityLock"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible"
                android:contentDescription="Security" />

            <EditText
                android:id="@+id/etAddressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_or_type_url"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnClearUrl"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                tools:visibility="visible"
                android:contentDescription="@string/clear" />
        </LinearLayout>

        <!-- Top Menu / Tab Button -->
        <FrameLayout
            android:id="@+id/btnTopTabs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tabs"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="@string/tabs" />

            <TextView
                android:id="@+id/tvTopTabCount"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnTopMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_more"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="@string/settings" />

    </LinearLayout>

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBarContainer"
        tools:progress="50"
        tools:visibility="visible" />

    <!-- Web View & Content Container -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBarContainer"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <!-- Start Page View -->
        <include
            android:id="@+id/startPageView"
            layout="@layout/view_start_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Error State View -->
        <include
            android:id="@+id/errorView"
            layout="@layout/view_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Floating Auto-Claim Quick Action Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabMultiInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="⚡ AUTO CLAIM"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="?attr/colorPrimary"
        app:icon="@drawable/ic_send"
        app:iconTint="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/bottomBarContainer"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="Back" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/ic_forward"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="Forward" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="Reload" />

        <ImageButton
            android:id="@+id/btnAddTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/ic_add"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@string/new_tab" />

        <FrameLayout
            android:id="@+id/btnTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tabs"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="@string/tabs" />

            <TextView
                android:id="@+id/tvTabCount"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
