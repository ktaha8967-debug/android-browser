<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeColor="?android:attr/dividerVertical"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivProxyIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_proxy"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Proxy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProxyProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="US East HTTP" />

            <TextView
                android:id="@+id/tvProxyAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                tools:text="192.168.1.100:8080" />

            <TextView
                android:id="@+id/tvProxyAssignment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                tools:text="Assigned to Tab #1" />

        </LinearLayout>

        <!-- Toggle enabled -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchProxyEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Edit -->
        <ImageButton
            android:id="@+id/btnEditProxy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_edit"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="@string/edit_proxy" />

        <!-- Delete -->
        <ImageButton
            android:id="@+id/btnDeleteProxy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="?attr/colorError"
            android:contentDescription="@string/delete" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
